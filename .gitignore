# 依存関係
node_modules/
site/node_modules/

# 環境変数（絶対にcommitしない）
.env
.env.*
!.env.example

# ローカルSQLite（Tursoに同期済み）
data/*.db

# 大容量生データ（Turso管理）
data/mgs_products.jsonl
data/mgs_products_by_maker.jsonl
data/mgs_products_by_actress.jsonl
data/mgs_products_by_month.jsonl
data/mgs_details.jsonl
data/mgs_actress_matches.jsonl
data/mgs_video_urls.jsonl
data/fanza_products.jsonl
data/fanza_video_urls.jsonl
data/fanza_actresses_raw.jsonl

# ビルド出力
site/.next/
site/.open-next/
site/.wrangler/
site/tsconfig.tsbuildinfo
.next/

# ローカルDB（data/ 以外の場所）
db/mgs.db
mgs.db

# ログ
logs/

# スクレイパーロックファイル・デバッグ一時ファイル
data/*.lock
data/*.log
data/*.html
search_page_node.html
scripts/fanza_review_checkpoint.json
scripts/prefetch_mp4_progress.json

# D1移行用の生成SQL(巨大)・SQLite WAL
d1_export/
*.db-shm
*.db-wal

# SNS投稿の一時出力
data/x_tmp/
data/x_outbox/

# スクレイパー進捗のバックアップ
data/*.bak.json
data/*.bak2.json

# X Cookie失効アラートの状態
data/x_cookie_alert.json

# 女優表示キャッシュのシャード（actress_display_cache.json から build:shards で生成される派生物）
# 48MB あり、元データが commit されているので追跡しない。deploy:cf が毎回生成する。
site/data/actress_display/
site/public/data/actress_display/
site/data/actress_display_alias_index.json
site/public/data/actress_display_alias_index.json

# 出演者不明の旧作を削除した際のバックアップ(復旧用・大容量なので追跡しない)
data/purged/

# avwiki サイトマップのスラグ集合(約2.1MB)。無ければスクリプトが自動再取得するので追跡しない
data/avwiki_sitemap_slugs.json
